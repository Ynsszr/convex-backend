<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <OutputType>Exe</OutputType><PublishTrimmed>false</PublishTrimmed><RunAOTCompilation>false</RunAOTCompilation>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Contracts/ConvexApp.Contracts.fsproj" />
    <PackageReference Include="Convex.Client" Version="0.3.2" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
    <Compile Include="../artifacts/convex/NativeApi.fs" Link="NativeApi.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
</Project>
